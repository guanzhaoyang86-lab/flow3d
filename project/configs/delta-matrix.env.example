# Delta A100：复用已成功生成数据和训练基线的 x86_64 环境，不重装依赖。
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/delta-generation.env.example"
export FLOW3D_CPUS=8
export FLOW3D_MEM=32G
export FLOW3D_ARRAY_CONCURRENCY=16
export FLOW3D_PREPARE_TIME=02:00:00
export FLOW3D_TRAIN_TIME=02:00:00
export FLOW3D_EVALUATE_TIME=08:00:00
export FLOW3D_MANIFEST="/work/hdd/biup/$USER/datasets/2026-10-01_115342_lbm3d-full_22594936_7966ccef/manifest.json"
# 2 小时是单任务硬上限；每个 epoch 保存 latest.pt，超时需显式 matrix-resume。
# 此配置不取消其他集群的任务，评估不会自动提交。
