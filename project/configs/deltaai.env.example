# 已由 zguan2 的 accounts、sinfo、存储路径与 module spider 输出确认。
# 在 project/ 下 source configs/deltaai.env.example；不安装或修改站点 base 环境。
export FLOW3D_CLUSTER=deltaai
export FLOW3D_ACCOUNT=biup-dtai-gh
export FLOW3D_PARTITION=ghx4
export FLOW3D_ROOT="/work/hdd/biup/$USER"
export FLOW3D_GPUS=1
export FLOW3D_TIME=00:20:00
export FLOW3D_CPUS=16
export FLOW3D_MEM=32G
export FLOW3D_MODULES="python/miniforge3_pytorch/2.10.0"
export FLOW3D_CONDA_ENV=base
export FLOW3D_CONDA_SH=""
export FLOW3D_GPU_TYPE=""
export FLOW3D_CONSTRAINT=""
export FLOW3D_SNAPSHOT_ROOT="$HOME/projects/flow3d_runs"
