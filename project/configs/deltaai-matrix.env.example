# GH200 实验矩阵：在 project/ 下 source；使用站点 ARM PyTorch，无 Taichi。
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)/deltaai.env.example"
export FLOW3D_CPUS=8
export FLOW3D_MEM=64G
export FLOW3D_ARRAY_CONCURRENCY=4
export FLOW3D_PREPARE_TIME=02:00:00
export FLOW3D_TRAIN_TIME=08:00:00
export FLOW3D_EVALUATE_TIME=08:00:00
# 上述时间是可调整的申请上限，并非 GH200 计时预测。
# FLOW3D_TIME 来自通用配置；矩阵改用上述三个独立时间变量。
export FLOW3D_MANIFEST="/work/hdd/biup/$USER/datasets/2026-10-01_115342_lbm3d-full_22594936_7966ccef/manifest.json"
