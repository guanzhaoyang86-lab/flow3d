# Delta 的账户、分区和工作目录已由 zguan2 于 2026-10-01 确认。
# setup_delta_generation.sh 在 Delta HOME 创建独立 x86_64 环境。
export FLOW3D_CLUSTER=delta
export FLOW3D_ACCOUNT=biup-delta-gpu
export FLOW3D_PARTITION=gpuA100x4
export FLOW3D_ROOT="/work/hdd/biup/$USER"
export FLOW3D_GPUS=1
export FLOW3D_TIME=00:30:00
export FLOW3D_CPUS=8
export FLOW3D_MEM=32G
export FLOW3D_MODULES=miniforge3-python
export FLOW3D_CONDA_ENV="$HOME/envs/flow3d-lbm3d"
export FLOW3D_CONDA_SH=""
export FLOW3D_UPSTREAM_REPO="$HOME/projects/taichi_LBM3D"
export FLOW3D_GPU_TYPE=""
export FLOW3D_CONSTRAINT=""
export FLOW3D_SNAPSHOT_ROOT="$HOME/projects/flow3d_runs"
