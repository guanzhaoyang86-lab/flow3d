# 在本地编辑模板，经 GitHub 同步；HPC 复制到 ~/.config/flow3d/hpc.env 后 source。
# 用 accounts、sinfo、module avail 和配额路径核对下面的值。
export FLOW3D_CLUSTER=delta
export FLOW3D_ACCOUNT=PHY260443
export FLOW3D_PARTITION=gpuA100x4
# 必须替换为实际获配路径；Delta 当前文档将 /work/hdd 列为 scratch 卷。
# 若门户和登录环境确认仍提供 /scratch，可使用实际 $SCRATCH 路径。
export FLOW3D_ROOT="/work/hdd/<LOCAL_STORAGE_ACCOUNT>/$USER"
export FLOW3D_GPUS=1
export FLOW3D_TIME=48:00:00
export FLOW3D_CPUS=8
export FLOW3D_MEM=32G
export FLOW3D_CONDA_ENV=flow3d
# 已安装的、与 PyTorch 匹配的模块；不需要时留空。不盲目加载默认 CUDA。
export FLOW3D_MODULES=""
# conda 已在 PATH 可留空，否则设为实际 conda.sh 绝对路径。
export FLOW3D_CONDA_SH=""
export FLOW3D_SNAPSHOT_ROOT="$HOME/projects/flow3d_runs"
# 可选：按 sinfo -N -o '%N %f' 和站点说明填写文件系统约束。
export FLOW3D_CONSTRAINT=""
# 可选 GRES 类型：仅在 sinfo -o '%P %G' 确认类型后设 a100/h100 等。
# 留空时使用官方示例中的 --gpus-per-node=N，由 partition 选择 GPU 型号。
export FLOW3D_GPU_TYPE=""

# DeltaAI：在文件末尾启用以下覆盖项，并填写实际获配路径和模块版本。
# export FLOW3D_CLUSTER=deltaai
# export FLOW3D_PARTITION=ghx4
# export FLOW3D_ROOT="/work/hdd/<LOCAL_STORAGE_ACCOUNT>/$USER"
# export FLOW3D_MODULES="python/miniforge3_pytorch/2.10.0"
# export FLOW3D_CONDA_ENV="$HOME/.conda/envs/flow3d-deltaai"
